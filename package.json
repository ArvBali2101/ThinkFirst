{
  "name": "thinkfirst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first learning layer for ChatGPT.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chromium": "node scripts/build.mjs --target=chromium",
    "build:edge": "node scripts/build.mjs --target=edge",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:all": "node scripts/build.mjs --target=chromium && node scripts/build.mjs --target=edge && node scripts/build.mjs --target=firefox",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  }
}
